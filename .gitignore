# ---- personal data: never commit ----
portfolio.db
portfolio.db-wal
portfolio.db-shm
portfolio.db.pre-restore
config.json
# Everything dropped in or archived by a sync is raw broker data: tradebook CSVs
# carrying the account code, and statement PDFs carrying PAN, address and phone. The
# old rules named only *.json, so CSVs and PDFs sailed straight past them.
sync/inbox/*
sync/archive/*
!sync/inbox/.gitkeep
!sync/archive/.gitkeep
sync/prompts/*.txt
transactions.csv
positions.csv
report.json

# ---- machine state ----
__pycache__/
*.pyc
.DS_Store
*.log

# ---- optional analysis integration ----
analysis/
vendor/
tools/__pycache__/
